# Copy this file to ".env" and fill in your own values.
# .env is git-ignored and must never be committed.

# Apify API token (https://console.apify.com/account/integrations)
APIFY_TOKEN=your_apify_token_here

# Tavily API key (https://app.tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# Apify actor used to scrape X (Twitter) search results.
# PLACEHOLDER: replace with the actor ID you intend to use, e.g. a
# Twitter/X scraper actor from the Apify Store ("username~actor-name"
# or the actor's hex ID both work with the Apify API).
APIFY_TWITTER_ACTOR_ID=placeholder~twitter-scraper
